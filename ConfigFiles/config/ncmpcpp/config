# Configuration file for NCMPCPP.
# Read the user manual for documentation: https://manpages.debian.org/testing/ncmpcpp/ncmpcpp.1.en.html

mpd_host                                        = "127.0.0.1"
mpd_port                                        = "8000"
mpd_connection_timeout                          = "5"
mpd_crossfade_time                              = "5"
mpd_music_dir                                   = "~/Music"
ncmpcpp_directory                               = "~/.config/ncmpcpp"
lyrics_directory                                = "~/.config/ncmpcpp/lyrics"
execute_on_song_change                          = notify-send "Now Playing..." "$(mpc --host=127.0.0.1 --port=8000 --format '%artist% - %title% - %album%' current)"

######################### GENERAL #########################

allow_for_physical_item_deletion                = "no"
ask_for_locked_screen_width_part                = "yes"
autocenter_mode                                 = "yes"
browser_display_mode                            = "columns"
centered_cursor                                 = "yes"
connected_message_on_startup                    = "yes"
cyclic_scrolling                                = "yes"
display_bitrate                                 = "no"
external_editor                                 = "nano"
follow_now_playing_lyrics                       = "yes"
ignore_leading_the                              = "yes"
lines_scrolled                                  = "1"
locked_screen_width_part                        = "50"
message_delay_time                              = "3"
mouse_support                                   = "yes"
mouse_list_scroll_whole_page                    = "yes"
playlist_disable_highlight_delay                = "2"
playlist_display_mode                           = "columns"
playlist_editor_display_mode                    = "columns"
playlist_shorten_total_times                    = "yes"
search_engine_display_mode                      = "columns"
startup_screen                                  = "media_library"
user_interface                                  = "classic"

######################### VISUALIZER #########################

visualizer_color                                = "33,39,63,75,81,99,117,153,189"
visualizer_data_source                          = "/tmp/mpd.fifo"
visualizer_fps                                  = "60"
visualizer_in_stereo                            = "yes"
visualizer_look                                 = "●▮"
visualizer_output_name                          = "Visualizer"
visualizer_spectrum_smooth_look                 = "yes"
visualizer_type                                 = "wave_filled"

######################### PROGRESS BAR #########################

progressbar_color                               = "black"
progressbar_elapsed_color                       = "cyan"
progressbar_look                                = "━━╸"

######################### COLORS #########################

color1                                          = "white"
color2                                          = "blue"
main_window_color                               = "yellow"
header_window_color                             = "green"
volume_color                                    = "red"

######################### UI VISIBILITY #########################

header_visibility                               = "no"
enable_window_title                             = "yes"
statusbar_visibility                            = "yes"
titles_visibility                               = "yes"

######################### UI APPEARANCE #########################

current_item_prefix                             = "$b$7$/b$3"
current_item_suffix                             = "$8"
now_playing_prefix                              = "$b$8$7"
now_playing_suffix                              = "$/b$8"
song_columns_list_format                        = "(53)[white]{tr} (45)[blue]{a}"
song_library_format                             = "{{%a - %t} (%b)}|{%f}"
song_list_format                                = "$8%a - %t$R  %l"
song_status_format                              = "$7%t"
song_window_title_format                        = "Now Playing..."

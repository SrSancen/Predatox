# ────────────────────────────────────────────────────────────────────────────
#  FASE CHROOT · ETAPA 6/10 · PERSONALIZACION (repo SrSancen/Predatox)
# ────────────────────────────────────────────────────────────────────────────
# Descarga el repositorio de personalizacion. Devuelve 0 si lo logro.
# Orden de intento: tarball (rama main, luego master) y, si no, git clone;
# se prueban primero las URLs nuevas (SrSancen/Predatox) y despues el
# repositorio anterior como respaldo.
descargar_personalizacion() {
  local destino="$1" tmp rama repo
  [[ -d "$destino" ]] || mkdir -p "$destino" || return 1

  for repo in "${REPO_USUARIO}/${REPO_NOMBRE}" "${REPO_ALT_USUARIO}/${REPO_ALT_NOMBRE}"; do
    for rama in $REPO_RAMAS; do
      tmp="$(mktemp)"
      info "Descargando ${repo} (rama ${rama})..."
      if curl -fsSL --retry 2 --max-time 300 -o "$tmp" \
           "https://codeload.github.com/${repo}/tar.gz/refs/heads/${rama}" 2>/dev/null \
         && tar -tzf "$tmp" >/dev/null 2>&1; then
        rm -rf "${destino:?}/"* 2>/dev/null || true
        if tar -xzf "$tmp" -C "$destino" --strip-components=1 2>/dev/null; then
          rm -f "$tmp"
          ok "Personalizacion descargada de ${repo} (rama ${rama})."
          return 0
        fi
      fi
      rm -f "$tmp"
    done
    # Respaldo: clonar el repositorio completo.
    info "Sin tarball de ${repo}: intentando git clone..."
    if git clone --depth=1 "https://github.com/${repo}.git" "${destino}.tmp" >/dev/null 2>&1; then
      rm -rf "${destino:?}/"* 2>/dev/null || true
      cp -a "${destino}.tmp/." "$destino/" 2>/dev/null || true
      rm -rf "${destino}.tmp"
      ok "Personalizacion clonada de ${repo}."
      return 0
    fi
    rm -rf "${destino}.tmp" 2>/dev/null || true
  done
  return 1
}

# Descarga un archivo suelto del repo cuando no se pudo el tarball.
asegurar_archivo() { # <destino> <ruta dentro del repo>
  local dest="$1" rel="$2"
  [[ -s "$dest" ]] && return 0
  mkdir -p "$(dirname "$dest")" 2>/dev/null || true
  local rama
  for rama in $REPO_RAMAS; do
    if curl -fsSL --retry 2 -o "$dest" "${RAW_BASE}/${rama}/${rel}" 2>/dev/null && [[ -s "$dest" ]]; then
      return 0
    fi
  done
  return 1
}

# Localiza la carpeta ConfigFiles sin depender de la ruta exacta.
localizar_configfiles() { # <raiz>
  local raiz="$1" c
  for c in "$raiz/ConfigFiles" "$raiz" "$raiz/ArchInstall" "$raiz/ConfigFiles/ConfigFiles"; do
    if [[ -d "$c/config" || -d "$c/bin" || -d "$c/misc" || -d "$c/images" || -d "$c/grub" ]]; then
      printf '%s' "$c"
      return 0
    fi
  done
  c="$(find "$raiz" -maxdepth 4 -type d -name 'ConfigFiles' -print -quit 2>/dev/null)"
  if [[ -n "$c" ]]; then printf '%s' "$c"; return 0; fi
  return 1
}

# Localiza la carpeta ConfigFiles dentro del chroot. Cada paso lo busca por su
# cuenta en vez de recibir la ruta de uno solo: asi da igual el orden en que se
# ejecuten, y si la personalizacion se descarga mas tarde los pasos siguientes
# la encuentran igualmente.
configfiles_de() { # [ruta]  ->  imprime la ruta de ConfigFiles
  local base="${1:-${DESTINO_REPO:-}}" cf=""
  [[ -n "$base" ]] || base="/home/$USER_NAME/Repos/Predatox"
  cf="$(localizar_configfiles "$base" 2>/dev/null)" || return 1
  [[ -d "$cf" ]] || return 1
  printf '%s' "$cf"
}

ch_descargar_personalizacion() {
  DESTINO_REPO="/home/$USER_NAME/Repos/Predatox"
  mkdir -p "$(dirname "$DESTINO_REPO")" "/home/$USER_NAME/Repos"
  chown "$USER_NAME:$USER_NAME" "/home/$USER_NAME/Repos" 2>/dev/null || true
  if [[ -d "$DESTINO_REPO" ]] && localizar_configfiles "$DESTINO_REPO" >/dev/null 2>&1; then
    detalle "La personalizacion ya estaba descargada."
    return 0
  fi
  if descargar_personalizacion "$DESTINO_REPO"; then
    chown -R "$USER_NAME:$USER_NAME" "$DESTINO_REPO" 2>/dev/null || true
    return 0
  fi
  warn "No se pudo descargar ${REPO_USUARIO}/${REPO_NOMBRE}."
  detalle "El escritorio se instalara sin personalizacion; el resto del sistema funciona igual."
  return 1
}

ch_copiar_config() {
  local U="$USER_NAME" CF
  local H="/home/$U"
  CF="$(configfiles_de)" || { detalle "Sin carpeta ConfigFiles: se omite la personalizacion."; return 0; }
  ok "ConfigFiles localizado en $CF"

  mkdir -p "$H/Documents" "$H/Downloads" "$H/Music" "$H/Pictures" \
           "$H/.local/bin" "$H/.config" "$H/Repos" /usr/share/backgrounds /usr/share/zsh-sudo
  touch "$H/Documents/todo"

  # Configuraciones de awesome, binarios y miscelaneos (los archivos ocultos
  # se copian gracias a "cp -rf dir/.").
  [[ -d "$CF/config" ]] && cp -rf "$CF/config/." "$H/.config/"
  [[ -d "$CF/bin"    ]] && cp -rf "$CF/bin/." "$H/.local/bin/"
  [[ -d "$CF/misc"   ]] && cp -rf "$CF/misc/." "$H/"

  # Respaldo: si faltaron los archivos sueltos se piden uno por uno.
  asegurar_archivo "$H/.zshrc"            "ConfigFiles/misc/.zshrc"            || true
  asegurar_archivo "$H/.p10k.zsh_user"    "ConfigFiles/misc/.p10k.zsh_user"    || true
  asegurar_archivo "$H/.p10k.zsh_root"    "ConfigFiles/misc/.p10k.zsh_root"    || true
  asegurar_archivo "$H/sudo.plugin.zsh"   "ConfigFiles/misc/sudo.plugin.zsh"   || true
  asegurar_archivo "$H/slick-greeter.conf" "ConfigFiles/misc/slick-greeter.conf" || true

  chown -R "$U:$U" "$H" 2>/dev/null || true
  ok "Configuraciones copiadas al home de $U"
}

ch_tema_grub() {
  local CF H="/home/$USER_NAME"
  CF="$(configfiles_de "${1:-}")" || { detalle "Sin tema GRUB en el repositorio: se deja el tema estandar."; return 0; }
  if [[ ! -d "$CF/grub/HackTheBox" ]]; then
    detalle "Sin tema GRUB en el repositorio: se deja el tema estandar."
    return 0
  fi
  mkdir -p /boot/grub/themes
  rm -rf /boot/grub/themes/HackTheBox
  cp -rf "$CF/grub/HackTheBox" /boot/grub/themes/HackTheBox
  WALLPAPER_GRUB="$(elegir_wallpaper /boot/grub/themes/HackTheBox "background")" || WALLPAPER_GRUB=""
  if [[ -n "$WALLPAPER_GRUB" ]]; then
    mv -f "/boot/grub/themes/HackTheBox/$WALLPAPER_GRUB" /boot/grub/themes/HackTheBox/background.png
  fi
  # No se fija gfxmode: en VMs con EFI un modo no soportado deja pantalla negra.
  sed -i 's|^desktop-image:.*|desktop-image: "background.png"|' /boot/grub/themes/HackTheBox/theme.txt 2>/dev/null || true

  if [[ -s /boot/grub/themes/HackTheBox/background.png && -f /boot/grub/themes/HackTheBox/theme.txt ]]; then
    sed -i 's/^#GRUB_THEME=.*/GRUB_THEME="\/boot\/grub\/themes\/HackTheBox\/theme.txt"/' /etc/default/grub 2>/dev/null || true
    grep -q '^GRUB_THEME=' /etc/default/grub \
      || echo 'GRUB_THEME="/boot/grub/themes/HackTheBox/theme.txt"' >> /etc/default/grub
    ok "Tema GRUB HackTheBox aplicado."
  else
    warn "Fondo del tema GRUB invalido: se usa GRUB estandar (menu de texto)."
    sed -i 's/^GRUB_THEME=.*/#GRUB_THEME="\/boot\/grub\/themes\/HackTheBox\/theme.txt"/' /etc/default/grub 2>/dev/null || true
    rm -rf /boot/grub/themes/HackTheBox 2>/dev/null || true
  fi
  return 0
}


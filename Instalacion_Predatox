# ────────────────────────────────────────────────────────────────────────────
#  INTERFAZ: mensajes, registro y arte ASCII
# ────────────────────────────────────────────────────────────────────────────
registrar() { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*" >> "$LOG_FILE" 2>/dev/null || true; }

ok()    { echo -e "${C_VERDE}[OK]${C_RESET} $*";    registrar "OK    $*"; }
warn()  { echo -e "${C_AMAR}[AVISO]${C_RESET} $*"; registrar "AVISO $*"; }
fail()  { echo -e "${C_ROJO}[FALLO]${C_RESET} $*"; registrar "FALLO $*"; }
info()  { echo -e "${C_CIA}==>${C_RESET} $*";      registrar "INFO  $*"; }
detalle() { echo -e "       ${C_GRIS}$*${C_RESET}"; }
die()   { fail "$*"; echo; exit 1; }

separador() { echo -e "${C_CIA}$(repeticion '─' 79)"${C_RESET}; }

repeticion() { # <caracter> <cantidad>
  local c="$1" n="$2" s=""
  while (( n-- > 0 )); do s+="$c"; done
  printf '%s' "$s"
}

ancho_terminal() {
  local w="${COLUMNS:-0}"
  if (( w <= 0 )); then w="$(tput cols 2>/dev/null || echo 80)"; fi
  [[ "$w" =~ ^[0-9]+$ ]] || w=80
  (( w < 40 )) && w=80
  printf '%s' "$w"
}

# Ancho de un texto en columnas. Los rotulos llevan caracteres de dibujo
# (── ·) que ocupan una columna pero varios bytes, asi que en una consola sin
# locale UTF-8 hay que contar en un subshell con el locale puesto.
columnas() {
  local s="$1"
  ( export LC_ALL=C.UTF-8; printf '%s' "${#s}" ) 2>/dev/null || printf '%s' "${#s}"
}

# Ancho maximo de las lineas de un bloque de arte (separadas por \n)
ancho_arte() {
  local arte="$1" linea max=0
  while IFS= read -r linea; do
    (( ${#linea} > max )) && max=${#linea}
  done <<< "$arte"
  printf '%s' "$max"
}

# Imprime el arte solo si cabe en el terminal; si no, lo omite (la cabecera
# de etapa ya indica el nombre). Evita que el arte se parta a la mitad.
imprimir_arte() {
  local arte="$1" w
  [[ -n "$arte" ]] || return 1
  w="$(ancho_terminal)"
  if (( $(ancho_arte "$arte") <= w )); then
    printf '%s\n' "$arte"
    return 0
  fi
  return 1
}


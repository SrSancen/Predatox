# ────────────────────────────────────────────────────────────────────────────
#  FASE ISO · ETAPA 5/5 · COPIA DEL SCRIPT Y ENTRADA AL CHROOT
# ────────────────────────────────────────────────────────────────────────────
paso_copiar_script() {
  local tmp_script="/tmp/Instalacion_Predatox_directo"
  # Si se ejecuto como "bash <(curl ...)" o "curl | bash", $SELF es un pipe ya
  # consumido: se re-descarga a un archivo real.
  if [[ ! -f "$SELF" || ! -s "$SELF" ]]; then
    warn "El script no es un archivo local; descargandolo de $RAW_SCRIPT"
    curl -fsSL -o "$tmp_script" "$RAW_SCRIPT" || die "No se pudo descargar el script."
    SELF="$tmp_script"
  fi

  mkdir -p /mnt/root
  install -m 0755 "$SELF" "$SCRIPT_TARGET" 2>/dev/null || true
  if [[ ! -s "$SCRIPT_TARGET" || "$(head -c2 "$SCRIPT_TARGET" 2>/dev/null)" != "#!" ]]; then
    warn "Copia incompleta; descargando el script directamente a /root..."
    local rama
    for rama in $REPO_RAMAS; do
      curl -fsSL -o "$SCRIPT_TARGET" "${RAW_BASE}/${rama}/Instalacion_Predatox" && break
    done
    chmod 0755 "$SCRIPT_TARGET"
  fi
  [[ -s "$SCRIPT_TARGET" ]] || die "No se pudo dejar el script en $SCRIPT_TARGET"
  escribir_config "$CONFIG_TARGET"
  [[ -s "$CONFIG_TARGET" ]] || die "No se pudo escribir $CONFIG_TARGET"
  ok "Script ($(wc -c < "$SCRIPT_TARGET") bytes) y configuracion listos dentro de /mnt"
}

paso_entrar_chroot() {
  info "Entrando al sistema instalado (esto puede tardar varios minutos)..."

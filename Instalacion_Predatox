check_root() {
  if [[ $EUID -ne 0 ]]; then
    die "Ejecuta este script como root:  ./Instalacion_Predatox"
  fi
}

detectar_virtualizador() {
  local virt
  virt="$(systemd-detect-virt 2>/dev/null || true)"
  case "${virt,,}" in
    vmware)            echo "vmware" ;;
    oracle|virtualbox) echo "virtualbox" ;;
    *)                 echo "ninguna" ;;
  esac
}

detectar_boot_mode() {
  if [[ -d /sys/firmware/efi ]]; then echo "UEFI"; else echo "BIOS"; fi
}

detectar_zona_horaria() {
  local tz=""
  tz="$(curl -fsS --max-time 8 https://ipapi.co/timezone 2>/dev/null)" && [[ -n "$tz" ]] \
    || tz="$(curl -fsS --max-time 8 https://worldtimeapi.org/api/ip 2>/dev/null \
             | grep -oP '"timezone":\s*"[^"]+"' | head -n1 | cut -d'"' -f4)" || true
  [[ -n "$tz" ]] || tz="$(curl -fsS --max-time 8 http://ip-api.com/json 2>/dev/null \
             | grep -oP '"timezone":\s*"[^"]+"' | head -n1 | cut -d'"' -f4)" || true
  tz="${tz:-America/Mexico_City}"
  [[ -e "/usr/share/zoneinfo/$tz" ]] || tz="America/Mexico_City"
  echo "$tz"
}

# Disco de destino: el mas grande que NO sea el USB/ISO desde el que se
# arranco (formatear ese dispositivo destruiria el medio de instalacion) y,
# si es posible, sin puntos de montaje activos.
detectar_disco() {
  local nombre tamano iso_src iso_padre cand mejor="" mejor_gib=0 gib
  iso_src="$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
  if [[ -n "$iso_src" ]]; then
    iso_padre="/dev/$(lsblk -no PKNAME "$iso_src" 2>/dev/null)"
  else
    iso_padre="/dev/__ninguno__"
  fi

  while read -r nombre tamano; do
    [[ -b "$nombre" ]] || continue
    [[ "$nombre" == "$iso_padre" ]] && continue
    # Se descartan los discos con algo montado (medio de arranque, otro SO).
    if lsblk -nrpo MOUNTPOINT "$nombre" 2>/dev/null | grep -q '[^[:space:]]'; then continue; fi
    gib=$(( ${tamano:-0} / 1024 / 1024 / 1024 ))
    if (( gib > mejor_gib )); then
      mejor_gib="$gib"; mejor="$nombre"
    fi
  done < <(lsblk -b -dpno NAME,SIZE,TYPE 2>/dev/null | awk '$3=="disk" {print $1, $2}')

  # Si todos los discos tienen algo montado, se toma el mayor que no sea el ISO.
  if [[ -z "$mejor" ]]; then
    while read -r nombre tamano; do
      [[ -b "$nombre" ]] || continue
      [[ "$nombre" == "$iso_padre" ]] && continue
      gib=$(( ${tamano:-0} / 1024 / 1024 / 1024 ))
      if (( gib > mejor_gib )); then mejor_gib="$gib"; mejor="$nombre"; fi
    done < <(lsblk -b -dpno NAME,SIZE,TYPE 2>/dev/null | awk '$3=="disk" {print $1, $2}')
  fi

  [[ -n "$mejor" ]] || return 1
  echo "$mejor"
}

parsear_tamano() { # <1G|500M|2048> -> MiB
  local t="${1^^}" n
  t="${t// /}"
  n="${t//[A-Z]/}"
  case "$t" in
    *K|*KB) echo $(( ${n:-0} / 1024 + 1 )) ;;
    *M|*MB) echo "${n:-0}" ;;
    *G|*GB) echo $(( ${n:-0} * 1024 )) ;;
    *T|*TB) echo $(( ${n:-0} * 1024 * 1024 )) ;;
    "")     echo 0 ;;
    *[!0-9]*) echo 0 ;;
    *)      echo "${n:-0}" ;;
  esac
}

particion_n() { # <disco> <numero> -> /dev/nvme0n1p1 | /dev/sda1
  local disco="$1" num="$2"
  if [[ "$disco" == *nvme* ]]; then echo "${disco}p${num}"; else echo "${disco}${num}"; fi
}

elegir_wallpaper() { # <directorio> [prefijo]
  local dir="$1" pre="${2:-}" opciones
  shopt -s nullglob
  if [[ -n "$pre" ]]; then
    opciones=("$dir"/${pre}*.png "$dir"/${pre}*.jpg "$dir"/${pre}*.jpeg)
  else
    opciones=("$dir"/*.png "$dir"/*.jpg "$dir"/*.jpeg "$dir"/*.PNG "$dir"/*.JPG)
  fi
  shopt -u nullglob
  [[ ${#opciones[@]} -gt 0 ]] || return 1
  basename "${opciones[$(( RANDOM % ${#opciones[@]} ))]}"
}

# ────────────────────────────────────────────────────────────────────────────
#  CONTRASENAS: hash SHA-512 + "chpasswd -e"
#  Asi cualquier caracter especial ($, #, \, :, %, comillas, espacios) se
#  guarda tal cual: nunca pasa por un archivo de texto interpretable.
# ────────────────────────────────────────────────────────────────────────────
hash_contrasena() { # <contrasena> -> hash SHA-512 (o vacio si no hay openssl)
  local p="$1" h=""
  if command -v openssl >/dev/null 2>&1; then
    h="$(printf '%s' "$p" | openssl passwd -6 -stdin 2>/dev/null | tr -d '\n\r')"
  fi
  if [[ -z "$h" ]] && command -v python3 >/dev/null 2>&1; then
    h="$(printf '%s' "$p" | python3 -c \
      'import sys,crypt;print(crypt.crypt(sys.stdin.read(),crypt.mksalt(crypt.METHOD_SHA512)))' \
      2>/dev/null | tr -d '\n\r')"
  fi
  [[ "$h" == \$6\$* ]] || return 1
  printf '%s' "$h"
}

# Aplica una contrasena ya hasheada y VERIFICA que quedo bien guardada.
# Si chpasswd -e no surte efecto se reintenta con usermod -p.
aplicar_contrasena() { # <usuario> <hash> [contrasena_plana]
  local usr="$1" hash="$2" plano="${3:-}" real
  if [[ -n "$hash" && "$hash" == \$6\$* ]]; then
    printf '%s:%s\n' "$usr" "$hash" | chpasswd -e 2>/dev/null || true
    real="$(getent shadow "$usr" 2>/dev/null | cut -d: -f2)"
    if [[ "$real" != "$hash" ]]; then
      usermod -p "$hash" "$usr" 2>/dev/null || true
      real="$(getent shadow "$usr" 2>/dev/null | cut -d: -f2)"
    fi
  elif [[ -n "$plano" ]]; then
    printf '%s:%s\n' "$usr" "$plano" | chpasswd 2>/dev/null || true
  else
    fail "No hay contrasena disponible para $usr"
    return 1
  fi
  # La cuenta no debe quedar bloqueada ni con caducidad.
  chage -E -1 -M 99999 -I -1 "$usr" 2>/dev/null || true
  passwd -u "$usr" >/dev/null 2>&1 || true
  # Verificacion final: el hash guardado debe existir y estar activo.
  real="$(getent shadow "$usr" 2>/dev/null | cut -d: -f2)"
  if [[ -z "$real" || "$real" == '!'* || "$real" == '*' ]]; then
    fail "No se pudo guardar la contrasena de $usr"
    return 1
  fi
  ok "Contrasena de $usr guardada y verificada (SHA-512)"
  return 0
}

# ────────────────────────────────────────────────────────────────────────────
#  PREGUNTAS (solo 4) Y CONFIGURACION
# ────────────────────────────────────────────────────────────────────────────
preguntar() { # <variable> <mensaje> [default]
  local var="$1" msg="$2" def="${3:-}" r
  while :; do
    if [[ -n "$def" ]]; then
      printf '%s [%s]: ' "$msg" "$def"
    else
      printf '%s: ' "$msg"
    fi
    if ! read -r r; then return 1; fi
    r="${r#"${r%%[![:space:]]*}"}"
    r="${r%"${r##*[![:space:]]}"}"
    if [[ -n "$r" ]]; then
      printf -v "$var" '%s' "$r"
      return 0
    fi
    if [[ -n "$def" ]]; then
      printf -v "$var" '%s' "$def"
      return 0
    fi
    warn "El valor no puede estar vacio."
  done
}

# Usuario: acepta mayusculas y minusculas. Linux exige nombre en minusculas
# (useradd rechaza 'Pedrito'), asi que se normaliza y se avisa al usuario.
preguntar_usuario() {
  local r limpio
  while :; do
    printf 'Nombre del usuario personal (ej. Pedrito): '
    read -r r || exit 1
    limpio="$(printf '%s' "$r" | tr -d '[:space:]')"
    if [[ -z "$limpio" ]]; then
      warn "El nombre de usuario no puede estar vacio."
      continue
    fi
    if [[ ! "$limpio" =~ ^[A-Za-z][A-Za-z0-9._-]*$ ]]; then
      warn "Solo letras, numeros, punto, guion y subguion; debe iniciar con letra."
      continue
    fi
    if [[ "$limpio" =~ [A-Z] ]]; then
      USER_NAME="${limpio,,}"
      info "Se usara en minusculas (Linux no admite mayusculas en usuarios): $USER_NAME"
    else
      USER_NAME="$limpio"
    fi
    return 0
  done
}

# Hostname: acepta mayusculas y minusculas y las conserva tal cual.
preguntar_hostname() {
  local r
  while :; do
    printf 'Nombre del equipo (hostname, ej. Predatox-PC): '
    read -r r || exit 1
    r="$(printf '%s' "$r" | tr -d '[:space:]')"
    if [[ -z "$r" ]]; then
      warn "El nombre del equipo no puede estar vacio."
      continue
    fi
    if [[ ! "$r" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
      warn "Solo letras, numeros, punto, guion y subguion."
      continue
    fi
    HOSTNAME="$r"
    return 0
  done
}

# Contrasena: se lee sin eco y se convierte a hash SHA-512 de inmediato, de
# modo que ningun caracter especial se pierde al guardarla.
preguntar_contrasena() { # <variable> <etiqueta>
  local var="$1" msg="$2" p1 p2
  while :; do
    read -rsp "Contrasena de $msg: " p1; echo
    read -rsp "Repite la contrasena de $msg: " p2; echo
    if [[ -z "$p1" ]]; then
      warn "La contrasena no puede estar vacia."
      continue
    fi
    if [[ "$p1" != "$p2" ]]; then
      warn "Las contrasenas no coinciden, intenta de nuevo."
      continue
    fi
    # Ojo: el salto hay que escribirlo $'\n'. Con $(printf '\n') la
    # sustitucion de comando se come el salto, el patron queda "*" y el
    # aviso salta con cualquier contrasena.
    if [[ "$p1" == *$'\n'* || "$p1" == *$'\r'* ]]; then
      warn "La contrasena no puede contener saltos de linea."
      continue
    fi
    printf -v "${var}_PLANA" '%s' "$p1"
    if ! printf -v "${var}_HASH" '%s' "$(hash_contrasena "$p1")"; then
      fail "openssl no esta disponible: no se puede guardar la contrasena de forma segura."
      return 1
    fi
    unset p1 p2
    ok "Contrasena de $msg aceptada (se guardara cifrada en SHA-512)"
    return 0
  done
}


  separador
  echo "    Primer arranque:"
  echo "      1) Apaga la maquina y RETIRA la ISO de instalacion."
  echo "      2) Reinicia: entra con $USER_NAME y su contrasena."
  echo "      3) Crea un SNAPSHOT de respaldo del sistema ya instalado."
  separador
  echo "    Extras opcionales:"
  echo "      * Tema HackTheBox para YouTube (extension Stylus):"
  echo "        https://github.com/hekatonkheirex/youtube/raw/main/hackthebox.user.css"
  echo "      * Si picom-git se ve mal: sudo pacman -S picom"
  separador
}

# ────────────────────────────────────────────────────────────────────────────
#  FASE CHROOT (punto de entrada dentro de /mnt)
# ────────────────────────────────────────────────────────────────────────────
fase_chroot() {
  LOG_FILE="/var/log/instalacion_predatox.log"
  # shellcheck source=/dev/null
  source /etc/predatox.conf

  banner
  info "FASE CHROOT · configurando el sistema instalado en /mnt"
  registrar "=== INICIO FASE CHROOT ==="
  echo

  # Numero total de etapas de esta fase (segun lo que este habilitado).
  ETAPA_ACTUAL=0
  ETAPA_TOTAL=5                                        # 1,2,3 + grub + cierre
  if [[ "$INSTALL_PARU" == "S" || "$INSTALL_BLACKARCH" == "S" ]]; then
    ETAPA_TOTAL=$(( ETAPA_TOTAL + 1 ))
  fi
  if [[ "$INSTALL_GUI" == "S" ]]; then
    ETAPA_TOTAL=$(( ETAPA_TOTAL + 3 ))                  # grafico, escritorio, root
  fi
  if [[ "$INSTALL_PENTEST" == "S" ]]; then
    ETAPA_TOTAL=$(( ETAPA_TOTAL + 1 ))
  fi

  nueva_etapa "CONFIGURACION DEL SISTEMA" "$(arte_linux)"
  PASO_TOT=5
  paso "Locale y formato regional"      ch_locale
  paso "Teclado de consola"             ch_teclado
  paso "Zona horaria y reloj"           ch_hora
  paso "Nombre del equipo y /etc/hosts" ch_hostname
  paso "Configuracion de red"           ch_red

  nueva_etapa "USUARIOS, CONTRASENAS Y SUDO"
  PASO_TOT=5
  paso "Contrasena de root"             ch_contrasena_root
  paso "Crear el usuario $USER_NAME"    ch_usuario
  paso "Contrasena de $USER_NAME"       ch_contrasena_usuario
  paso "Grupos del usuario"             ch_grupos
  paso "Permisos de sudo"               ch_sudoers

  nueva_etapa "PACMAN Y ACTUALIZACION"
  PASO_TOT=2
  paso "Optimizar pacman.conf"          ch_pacman_conf
  paso "Actualizar el sistema base"     ch_actualizar

  if [[ "$INSTALL_PARU" == "S" || "$INSTALL_BLACKARCH" == "S" ]]; then
    nueva_etapa "PARU (AUR) Y BLACKARCH" "$(arte_paru)"
    PASO_TOT=2
    paso "Paru, ayudante del AUR"       ch_paru
    paso "Repositorios BlackArch"        ch_blackarch
  else
    # Sin Paru se necesita sudo sin contrasena para el resto de la instalacion.
    printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$USER_NAME" > /etc/sudoers.d/90-instalacion_predatox
    chmod 440 /etc/sudoers.d/90-instalacion_predatox
  fi

  if [[ "$INSTALL_GUI" == "S" ]]; then
    nueva_etapa "ENTORNO GRAFICO (AWESOMEWM)" "$(arte_escritorio)"
    PASO_TOT=4
    paso "Paquetes de Xorg, audio y utilidades" ch_paquetes_gui
    paso "AwesomeWM, picom y compositor"        ch_awesome
    paso "Teclado del escritorio"               ch_teclado_x11
    paso "LightDM y sesion grafica"             ch_lightdm

    nueva_etapa "PERSONALIZACION DEL ESCRITORIO"
    PASO_TOT=8
    paso "Descargar ${REPO_USUARIO}/${REPO_NOMBRE}"  ch_descargar_personalizacion
    paso "Copiar configuraciones al home"            ch_copiar_config
    paso "Tema de GRUB"                              ch_tema_grub
    paso "Wallpapers (login, escritorio, GRUB)"      ch_wallpapers
    paso "Fuentes tipograficas"                      ch_fuentes
    paso "Shell zsh del usuario"                     ch_zsh
    paso "fzf (historial difuso)"                    ch_fzf
    paso "Neovim con NvChad"                         ch_nvim

    nueva_etapa "ENTORNO DE ROOT"
    PASO_TOT=3
    paso "zsh y .zshrc de root"                ch_root_shell
    paso "powerlevel10k de root"               ch_root_powerlevel
    paso "nvim y fzf de root"                  ch_root_nvim_fzf
  else
    paso_teclado_x11
  fi

  nueva_etapa "GRUB Y SERVICIOS"
  PASO_TOT=3
  paso "Instalar GRUB ($BOOT_MODE)"      ch_grub
  paso "Habilitar servicios del sistema" ch_servicios
  paso "Regenerar el menu de arranque"   ch_grub_mkconfig

  if [[ "$INSTALL_PENTEST" == "S" ]]; then
    nueva_etapa "HERRAMIENTAS DE PENTESTING" "$(arte_pentest)"
    PASO_TOT=1
    paso "Instalar herramientas de pentest" ch_pentest
  fi

  nueva_etapa "CIERRE"
  PASO_TOT=4
  paso "Retirar permisos temporales"  ch_quitar_nopasswd
  paso "Permisos de archivos"        ch_permisos
  paso "Indice de archivos"          ch_indice
  paso "Registro de la instalacion"  ch_log

  ch_resumen
  registrar "=== FIN FASE CHROOT ==="
}

# ────────────────────────────────────────────────────────────────────────────
#  FASE ISO (punto de entrada desde el live USB)
# ────────────────────────────────────────────────────────────────────────────
fase_iso() {
  # Se comprueba root antes de pintar nada: si falta, se avisa y se sale.
  check_root
  banner
  LOG_FILE="/tmp/instalacion_predatox.log"
  : > "$LOG_FILE" 2>/dev/null || true
  registrar "=== INICIO FASE ISO ==="

  # 1) Comprobaciones basicas
  info "Comprobando conexion a internet..."
  if curl -fsS --max-time 10 https://archlinux.org >/dev/null 2>&1; then
    ok "Conexion a internet disponible."
  elif ping -c 2 -W 3 1.1.1.1 >/dev/null 2>&1; then
    warn "No responde HTTPS, pero hay red. Se continuara."
  else
    die "Sin conexion a internet: no se puede instalar ni descargar la personalizacion."
  fi

  # 2) Preguntas: solo 4
  if [[ -n "${CONFIG_PRECARGADA:-}" ]]; then
    leer_config "$CONFIG_PRECARGADA"
  else
    info "Se preguntaran solo 4 datos: usuario, equipo y las dos contrasenas."
    preguntar_usuario
    preguntar_hostname
    preguntar_contrasena ROOT_PASS root
    preguntar_contrasena USER_PASS "$USER_NAME"
  fi

  # Si las contrasenas vienen del archivo de configuracion se cifran aqui.
  if [[ -z "${ROOT_PASS_HASH:-}" && -n "${ROOT_PASS:-}" ]]; then
    ROOT_PASS_HASH="$(hash_contrasena "$ROOT_PASS")" || die "No se pudo cifrar la contrasena de root."
  fi
  if [[ -z "${USER_PASS_HASH:-}" && -n "${USER_PASS:-}" ]]; then
    USER_PASS_HASH="$(hash_contrasena "$USER_PASS")" || die "No se pudo cifrar la contrasena de $USER_NAME."
  fi
  [[ -n "${ROOT_PASS_HASH:-}" ]] || die "Falta la contrasena de root."
  [[ -n "${USER_PASS_HASH:-}" ]] || die "Falta la contrasena de $USER_NAME."

  # 3) Valores automaticos y resumen (sin confirmacion)
  aplicar_valores_automaticos
  resumen_config

  ETAPA_ACTUAL=0
  ETAPA_TOTAL=5

  nueva_etapa "PREPARACION DEL ENTORNO" "$(arte_primer)"
  PASO_TOT=3
  paso "Cargar distribucion del teclado ($KEYMAP)" paso_teclado
  paso "Zona horaria ($TIMEZONE)"                paso_hora
  paso "Deteccion del disco de destino"          paso_detectar_disco

  nueva_etapa "PARTICIONADO DEL DISCO"
  PASO_TOT=2
  paso "Crear la tabla de particiones ($BOOT_MODE)" paso_tabla_particiones
  paso "Verificar las particiones"                  paso_esperar_particiones

  nueva_etapa "FORMATEO Y MONTAJE"
  PASO_TOT=2
  paso "Formatear particiones"          paso_formatear
  paso "Montar en /mnt y activar swap"  paso_montar

  nueva_etapa "INSTALACION DEL SISTEMA BASE"
  PASO_TOT=2
  paso "Paquetes base con pacstrap" paso_pacstrap
  paso "Generar fstab"             paso_fstab

  nueva_etapa "CONFIGURACION DENTRO DE CHROOT"
  PASO_TOT=2
  paso "Copiar script y configuracion"    paso_copiar_script
  paso "Ejecutar la configuracion del sistema" paso_entrar_chroot

  # Cierre de la fase ISO
  separador
  sync
  umount -R /mnt 2>/dev/null || true
  swapoff -a 2>/dev/null || true
  echo -e "${C_VERDE}[OK]${C_RESET} Instalacion terminada correctamente."

  if [[ "$AUTO_REBOOT" == "S" ]]; then
    echo "Reiniciando en 10 segundos (Ctrl+C para cancelar y apagar manualmente)..."
    sleep 10
    reboot
  else
    info "AUTO_REBOOT=N: apaga la maquina, retira la ISO y enciende de nuevo."
  fi
}

# ────────────────────────────────────────────────────────────────────────────
#  MAIN
# ────────────────────────────────────────────────────────────────────────────
ayuda() {
  cat <<'EOF'
Instalacion_Predatox · instalador automatizado de Arch Linux

  ./Instalacion_Predatox                      instala preguntando 4 datos
  ./Instalacion_Predatox --config ARCHIVO     instala con configuracion precargada
  ./Instalacion_Predatox --help               muestra esta ayuda

Variables que se pueden fijar en el archivo de configuracion:
  DISK=/dev/nvme0n1   BOOT_SIZE=1G   SWAP_SIZE=5G   FREE_SIZE=0G
  KEYMAP=es  LANG_CFG=es_MX.UTF-8  XKBLAYOUT=latam  TIMEZONE=America/Mexico_City
  BOOT_MODE=UEFI|BIOS  VIRTUALIZER=vmware|virtualbox|ninguna
  INSTALL_GUI=S|N  INSTALL_PARU=S|N  INSTALL_BLACKARCH=S|N  INSTALL_PENTEST=S|N
  STATIC_IP=S|N  IFACE=  IPV4=  PREFIX=  GATEWAY=  DNS=
  AUTO_REBOOT=S|N
  ROOT_PASS=  USER_PASS=      (si se usan, el script los cifra en SHA-512)
EOF
}

main() {
  case "${1:-}" in
    --help|-h) ayuda; exit 0 ;;
  esac

  if [[ "${1:-}" == "chroot" ]]; then
    fase_chroot
    exit $?
  fi

  if [[ "${1:-}" == "--config" ]]; then
    [[ -n "${2:-}" ]] || die "Falta la ruta del archivo de configuracion."
    CONFIG_PRECARGADA="$2"
  fi

  fase_iso
}

main "$@"

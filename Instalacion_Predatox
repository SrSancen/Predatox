# ────────────────────────────────────────────────────────────────────────────
#  PROGRESO POR ETAPAS
# ────────────────────────────────────────────────────────────────────────────
ETAPA_NUM=0
ETAPA_TOT=1
ETAPA_ACTUAL=0
ETAPA_TOTAL=1
PASO_NUM=0
PASO_TOT=1

barra() { # <porcentaje 0-100>
  local v="$1" ancho=26 lleno i out=""
  (( v < 0 )) && v=0
  (( v > 100 )) && v=100
  lleno=$(( v * ancho / 100 ))
  for (( i = 0; i < ancho; i++ )); do
    if (( i < lleno )); then out+="█"; else out+="░"; fi
  done
  printf '%s' "$out"
}

etapa() { # <numero> <total> <nombre> [arte]
  local num="$1" tot="$2" nombre="$3" arte="${4:-}"
  local rotulo="$num/$tot · $nombre" pre="── ETAPA " suf="──"
  local ancho guiones
  ETAPA_NUM="$num"; ETAPA_TOT="$tot"; PASO_NUM=0
  echo
  # 1) Arte del guide si viene dado y cabe; si no, el rotulo compacto del
  #    nombre de la etapa (siempre cabe porque se parte en varios trozos).
  if [[ -n "$arte" ]] && imprimir_arte "$arte"; then
    :
  else
    imprimir_arte "$(arte_titulo "$nombre")" || true
  fi
  # 2) Linea de etapa: "ETAPA n/total · nombre" con regla de cierre. Si el
  #    terminal es estrecho, el nombre se pasa a su propia linea.
  ancho="$(ancho_terminal)"
  (( ancho > 72 )) && ancho=72
  if (( $(columnas "$pre $rotulo $suf") + 3 <= ancho )); then
    guiones=$(( ancho - $(columnas "$pre $rotulo $suf") ))
    (( guiones < 3 )) && guiones=3
    echo -e "${C_CIA}${pre}${C_VERDE}${rotulo}${C_RESET}${C_CIA}$(repeticion '─' "$guiones")${suf}${C_RESET}"
  else
    pre+="$num/$tot "
    guiones=$(( ancho - $(columnas "$pre $suf") ))
    (( guiones < 3 )) && guiones=3
    echo -e "${C_CIA}${pre}$(repeticion '─' "$guiones")${suf}${C_RESET}"
    echo -e "${C_VERDE}   $nombre${C_RESET}"
  fi
}

# nueva_etapa <nombre> [arte]  ->  numera sola dentro de la fase actual
nueva_etapa() {
  ETAPA_ACTUAL=$(( ETAPA_ACTUAL + 1 ))
  etapa "$ETAPA_ACTUAL" "$ETAPA_TOTAL" "$1" "${2:-}"
}

# paso <descripcion> <comando> [args...]  ->  anuncia el paso y lo ejecuta
paso() {
  local desc="$1"; shift
  PASO_NUM=$(( PASO_NUM + 1 ))
  local pct=$(( PASO_NUM * 100 / PASO_TOT ))
  local b
  if (( pct > 100 )); then pct=100; fi
  b="$(barra "$pct")"
  echo -e "  ${C_MAG}▸${C_RESET} ${C_CIA}[${b}] ${pct}%${C_RESET}  ${desc}"
  registrar "PASO $PASO_NUM/$PASO_TOT - $desc"
  if "$@"; then
    return 0
  fi
  warn "No se pudo completar: $desc"
  return 1
}

# ────────────────────────────────────────────────────────────────────────────

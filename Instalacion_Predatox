#!/usr/bin/env bash
#
#   Instalacion_Predatox - Instalador automatizado y personalizable de Arch Linux
#   ═══════════════════════════════════════════════════════════════════════════
#
#   Integra en un solo script la informacion de:
#     - ArchInstall.sh          (fase ISO: particionado + pacstrap)
#     - ArchConfig.sh           (fase chroot: configuracion del sistema)
#     - Instalacion de Arch Personalizado.txt   (guia completa)
#     - Guia de Instalacion.txt                 (notas y personalizacion)
#
#   EJECUCION DESDE EL ISO OFICIAL DE ARCH LINUX (primer booteo):
#     Estando en la consola del ISO y con internet:
#       loadkeys es
#       curl -fsSL -o Instalacion_Predatox https://raw.githubusercontent.com/SrSancen/ArchInstall/main/Instalacion_Predatox
#       chmod +x Instalacion_Predatox
#       ./Instalacion_Predatox
#     O bien, directo de internet a la consola del ISO:
#       bash <(curl -fsSL https://raw.githubusercontent.com/SrSancen/ArchInstall/main/Instalacion_Predatox)
#
#   Tambien puedes llevar una configuracion precargada (opcional):
#       ./Instalacion_Predatox --config /ruta/predatox.conf
#
#   Que hace:
#     1) Pide los datos necesarios (usuario, hostname, contrasenas, disco,
#        tamaños de particion, zona horaria, teclado, wallpapers, etc.).
#     2) Particiona, formatea y monta el disco (soporta UEFI/GPT y BIOS/MBR,
#        discos SATA (sda) y NVMe (nvme0n1)).
#     3) Instala el sistema base con pacstrap y genera el fstab.
#     4) Entra en chroot y configura todo automaticamente:
#          - locale, teclado, zona horaria, hostname, hosts
#          - usuarios (root y usuario personal) con permisos sudo
#          - pacman.conf (Color, ParallelDownloads, ILoveCandy)
#          - GRUB (BIOS y UEFI)
#          - Servicios (NetworkManager, sshd, wpa_supplicant, lightdm, etc.)
#          - IP fija opcional con nmcli
#          - Paru (AUR), repositorios BlackArch (opcionales)
#          - Entorno grafico AwesomeWM personalizado (opcional)
#          - Herramientas de pentesting (opcionales)
#     5) Finaliza y reinicia el equipo.
#
#   NOTAS:
#     - neofetch fue retirado de los repositorios oficiales, se instala
#       fastfetch (su sucesor oficial).
#     - Se usa pipewire (estandar actual de Arch) en lugar de pulseaudio.
#     - En chroot se copia a /root/Instalacion_Predatox y se invoca con el
#       argumento "chroot" (no ejecutar a mano).
#     - Los archivos de personalizacion (wallpapers, tema GRUB, config de
#       awesome, fuentes) se descargan por tarball desde el repo base
#       (yioshisancen/AwesomeWM). No se clona el repo via git; solo se
#       bajan los archivos necesarios, y quedan disponibles tambien junto
#       a este script en el repositorio de usuario (SrSancen/ArchInstall).
#     - El tema de GRUB solo se aplica si su fondo queda valido; si algo
#       falla se usa GRUB estandar para evitar pantalla negra al reiniciar.
#
#   RECURSOS / REFERENCIAS (de la documentacion original):
#     - Documentacion Arch Linux : https://wiki.archlinux.org/title/Installation_guide
#     - Documentacion AwesomeWM  : https://awesomewm.org/doc/api/documentation/07-my-first-awesome.md.html
#     - Entorno Awesome de rxyhn : https://github.com/rxyhn/yoru/tree/a2faa2ffad7c439ed7abe9a3f43e54e9b3bfc762
#     - Sistema de login LightDM : https://wiki.archlinux.org/title/LightDM
#     - Powerlevel10k            : https://github.com/romkatv/powerlevel10k
#     - Fzf                      : https://github.com/junegunn/fzf
#     - NvChad (Neovim)          : https://github.com/NvChad/NvChad
#     - Tema Style HackTheBox    : https://github.com/hekatonkheirex/youtube

set -uo pipefail

# ──────────────────────────────────────────────────────────────────────────
#  CONSTANTES
# ──────────────────────────────────────────────────────────────────────────
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "$0")"
CONFIG_TARGET="/mnt/etc/predatox.conf"     # config que lee la fase chroot
SCRIPT_TARGET="/mnt/root/Instalacion_Predatox"
RAW_SCRIPT="https://raw.githubusercontent.com/SrSancen/ArchInstall/main/Instalacion_Predatox"
# Repositorio base con los archivos de personalizacion (ConfigFiles).
# Tambien es URL de descarga oficial por tarball (evita depender de git).
AWESOME_USER="yioshisancen"
AWESOME_BRANCH="main"
AWESOME_DL="https://codeload.github.com/${AWESOME_USER}/AwesomeWM/tar.gz/refs/heads/${AWESOME_BRANCH}"


# ────────────────────────────────────────────────────────────────────────────
#  FASE ISO · ETAPA 2/5 · PARTICIONADO
# ────────────────────────────────────────────────────────────────────────────
paso_tabla_particiones() {
  local total_mib boot_mib swap_mib free_mib root_end boot_end
  total_mib=$(( $(blockdev --getsz "$DISK") * 512 / 1024 / 1024 ))
  boot_mib="$(parsear_tamano "$BOOT_SIZE")"
  swap_mib="$(parsear_tamano "$SWAP_SIZE")"
  free_mib="$(parsear_tamano "$FREE_SIZE")"
  boot_end=$(( 1 + boot_mib ))
  root_end=$(( total_mib - swap_mib - free_mib ))
  if (( root_end <= boot_end )); then
    die "Tamanos invalidos para un disco de ${total_mib} MiB (BOOT_SIZE=$BOOT_SIZE, SWAP_SIZE=$SWAP_SIZE)."
  fi
  info "Tabla $BOOT_MODE en $DISK: arranque ${boot_mib} MiB · root $(( root_end - boot_end )) MiB · swap ${swap_mib} MiB"

  umount -R /mnt 2>/dev/null || true
  swapoff -a 2>/dev/null || true
  wipefs -a "$DISK" >/dev/null 2>&1 || true

  if [[ "$BOOT_MODE" == "UEFI" ]]; then
    parted -s "$DISK" mklabel gpt
    parted -s "$DISK" mkpart ESP fat32 1MiB "${boot_end}MiB"
    parted -s "$DISK" set 1 esp on
    parted -s "$DISK" mkpart primary ext4 "${boot_end}MiB" "${root_end}MiB"
    parted -s "$DISK" mkpart primary linux-swap "${root_end}MiB" 100%
  else
    parted -s "$DISK" mklabel msdos
    parted -s "$DISK" mkpart primary ext4 1MiB "${boot_end}MiB"
    parted -s "$DISK" set 1 boot on
    parted -s "$DISK" mkpart primary ext4 "${boot_end}MiB" "${root_end}MiB"
    parted -s "$DISK" mkpart primary linux-swap "${root_end}MiB" 100%
  fi
  ok "Particiones creadas."
}

paso_esperar_particiones() {
  local p3 c
  p3="$(particion_n "$DISK" 3)"
  for (( c = 0; c < 20; c++ )); do
    if lsblk -pno NAME "$DISK" 2>/dev/null | grep -q -- "$p3$"; then break; fi
    sleep 1
  done
  partprobe "$DISK" 2>/dev/null || true
  sleep 2
  lsblk -p "$DISK" | sed 's/^/       /'
}

# ────────────────────────────────────────────────────────────────────────────
#  FASE ISO · ETAPA 3/5 · FORMATEO Y MONTAJE (sin confirmacion)
# ────────────────────────────────────────────────────────────────────────────
paso_formatear() {
  local p1 p2 p3
  p1="$(particion_n "$DISK" 1)"; p2="$(particion_n "$DISK" 2)"; p3="$(particion_n "$DISK" 3)"
  info "Formateando $p1, $p2 y $p3..."
  if [[ "$BOOT_MODE" == "UEFI" ]]; then
    mkfs.fat -F32 "$p1" >/dev/null || die "No se pudo formatear $p1"
  else
    mkfs.ext4 -F -q "$p1" >/dev/null || die "No se pudo formatear $p1"
  fi
  mkfs.ext4 -F -q "$p2" >/dev/null || die "No se pudo formatear $p2"
  mkswap "$p3" >/dev/null || die "No se pudo crear el area de swap en $p3"
  ok "Formateo completado."
}

paso_montar() {
  local p1 p2 p3
  p1="$(particion_n "$DISK" 1)"; p2="$(particion_n "$DISK" 2)"; p3="$(particion_n "$DISK" 3)"
  mkdir -p /mnt/boot
  mount "$p2" /mnt || die "No se pudo montar $p2 en /mnt"
  mount "$p1" /mnt/boot || die "No se pudo montar $p1 en /mnt/boot"
  swapon "$p3" 2>/dev/null || warn "No se pudo activar el swap en $p3"
  ok "Montajes listos en /mnt"
  lsblk -p "$DISK" | sed 's/^/       /'
}

# ────────────────────────────────────────────────────────────────────────────
#  FASE ISO · ETAPA 4/5 · SISTEMA BASE
# ────────────────────────────────────────────────────────────────────────────
paquetes_base() {
  local microcode=""
  if grep -qi "GenuineIntel" /proc/cpuinfo 2>/dev/null; then
    microcode="intel-ucode"
  elif grep -qi "AuthenticAMD" /proc/cpuinfo 2>/dev/null; then
    microcode="amd-ucode"
  fi
  [[ -n "$microcode" ]] && info "Microcode del procesador: $microcode"

  local pkgs=(base base-devel linux linux-firmware grub networkmanager wpa_supplicant
              openssh sudo vim nano git curl wget zsh plocate p7zip zip unzip tar feh
              fastfetch lsd bat openssl python)
  [[ -n "$microcode" ]] && pkgs+=("$microcode")

  if [[ "$BOOT_MODE" == "UEFI" ]]; then pkgs+=(efibootmgr); fi
  if [[ "$INSTALL_GUI" == "S" ]]; then
    pkgs+=(xorg-server xorg-xinit xorg-xrandr xorg-xsetroot lightdm lightdm-slick-greeter xdg-utils)
  fi
  case "$VIRTUALIZER" in
    # VMware ya no publica xf86-video-vmware: el driver modesetting de
    # xorg-server cubre los graficos.
    vmware)     pkgs+=(open-vm-tools xf86-input-vmmouse) ;;
    virtualbox) pkgs+=(virtualbox-guest-utils) ;;
  esac

  info "Ejecutando pacstrap (puede tardar varios minutos)..."
  pacstrap -K /mnt --noconfirm "${pkgs[@]}" \
    || die "Fallo pacstrap. Revisa el mensaje anterior (conexion a red o clave de firma)."
  ok "Sistema base instalado."
}

paso_pacstrap() { paquetes_base; }


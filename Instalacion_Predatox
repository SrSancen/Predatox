# arte_titulo <TEXTO>  ->  dibuja el texto en el arte compacto (3 lineas por
# trozo). Los rotulos largos se parten en varias filas para que el arte nunca
# se corte. Las tildes y la "ñ" se cambian por su letra base y los signos que
# no tienen glifo se descartan.
arte_titulo() {
  local txt="${1^^}" c letra a b d por_letra
  local linea palabra primera=1
  local -a palabras=() trozos=()
  local r1="" r2="" r3="" l1="" l2="" l3="" j
  txt="${txt//Á/A}"; txt="${txt//É/E}"; txt="${txt//Í/I}"; txt="${txt//Ó/O}"
  txt="${txt//Ú/U}"; txt="${txt//Ü/U}"; txt="${txt//Ñ/N}"
  txt="$(printf '%s' "$txt" | tr -cd 'A-Z ' | sed -e 's/ \{2,\}/ /g' -e 's/^ //' -e 's/ $//')"
  [[ -n "$txt" ]] || return 1

  # 1) Reparte el texto en trozos que caben en el terminal, sin partir
  #    palabras por la mitad salvo que no haya otra forma.
  por_letra=$(( ($(ancho_terminal) - 1) / 5 ))    # 5 columnas por letra - margen
  (( por_letra > 20 )) && por_letra=20
  (( por_letra < 4 ))  && por_letra=4
  read -ra palabras <<< "$txt"
  for palabra in "${palabras[@]}"; do
    if (( primera )); then
      linea="$palabra"; primera=0
    elif (( ${#linea} + 1 + ${#palabra} <= por_letra )); then
      linea+=" $palabra"
    else
      trozos+=("$linea"); linea="$palabra"
    fi
    while (( ${#linea} > por_letra )); do
      trozos+=("${linea:0:por_letra}"); linea="${linea:por_letra}"
    done
  done
  [[ -n "$linea" ]] && trozos+=("$linea")

  # 2) Dibuja cada trozo en sus tres lineas.
  for j in "${trozos[@]}"; do
    l1=""; l2=""; l3=""
    local k
    for (( k = 0; k < ${#j}; k++ )); do
      c="${j:k:1}"
      l1+="     "; l2+="     "; l3+="     "        # celda de 4 col. + separador
      [[ "$c" == " " || ! "$c" =~ ^[A-Z]$ ]] && continue
      while IFS=';' read -r letra a b d; do
        d="${d%$'\n'}"                     # el ultimo campo se come el salto
        if [[ "$letra" == "$c" ]]; then
          l1="${l1:0:${#l1}-5}${a} "       # sustituye la celda en blanco
          l2="${l2:0:${#l2}-5}${b} "
          l3="${l3:0:${#l3}-5}${d} "
          break
        fi
      done <<< "$FUENTE_ASCII"
    done
    r1+="$l1"$'\n'; r2+="$l2"$'\n'; r3+="$l3"$'\n'
  done
  printf '%s%s%s' "$r1" "$r2" "$r3"
}

# Recuadro de etapa: siempre ASCII para que el ancho nunca se descuadre.
recuadro() { # <titulo>
  local t="$1" ancho=77 pad
  pad=$(( ancho - ${#t} - 1 ))
  (( pad < 1 )) && pad=1
  echo -e "${C_CIA}╔$(repeticion '═' "$ancho")╗${C_RESET}"
  echo -e "${C_CIA}║${C_RESET} ${C_VERDE}${t}${C_RESET}$(printf '%*s' "$pad" '')${C_CIA}║${C_RESET}"
  echo -e "${C_CIA}╚$(repeticion '═' "$ancho")╝${C_RESET}"
}

